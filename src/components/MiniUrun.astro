---
/** Compact product row with a one-tap add (first size). Used in the home "Sık aranan" tiles. */
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { fiyat } from '../data/site';
import type { Urun } from '../data/urunler';
interface Props { urun: Urun }
const { urun: u } = Astro.props;
const ilk = u.secenekler[0];
const kucuk = await getImage({ src: u.gorsel, width: 160, height: 160, fit: 'contain', format: 'webp' });
---
<form class="mini" data-sepete-ekle method="post" action="/sepet">
  <input type="hidden" name="slug" value={u.slug} />
  <input type="hidden" name="ad" value={u.ad} />
  <input type="hidden" name="marka" value={u.marka} />
  <input type="hidden" name="gorsel" value={kucuk.src} />
  <input type="hidden" name="boy" value={`${ilk.boy}|${ilk.fiyat}`} />
  <a class="mini__gorsel" href={`/urun/${u.slug}`} tabindex="-1" aria-hidden="true"><Image src={u.gorsel} alt="" width={120} height={120} fit="contain" loading="lazy" /></a>
  <div class="mini__bilgi">
    <a class="mini__ad" href={`/urun/${u.slug}`}>{u.ad}</a>
    <span class="mini__alt">{ilk.boy} · <b>{fiyat(ilk.fiyat)}</b>{u.secenekler.length > 1 && <span class="mini__daha"> · {u.secenekler.length} boy</span>}</span>
  </div>
  <button type="submit" class="mini__btn" aria-label={`Sepete ekle: ${u.ad}, ${ilk.boy}`}><Icon ad="plus" agirlik="bold" boyut={18} /></button>
</form>
<style>
  .mini { display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--gri-200); }
  .mini__gorsel { display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--radius); background: var(--gri-100); }
  .mini__gorsel img { width: 46px; height: 46px; object-fit: contain; }
  .mini__bilgi { display: grid; gap: 2px; min-width: 0; }
  .mini__ad { font-weight: 600; font-size: 0.92rem; line-height: 1.3; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .mini__ad:hover { text-decoration: underline; }
  .mini__alt { font-size: 0.85rem; color: var(--gri-700); }
  .mini__alt b { color: var(--murekkep); font-family: var(--font-baslik); }
  .mini__daha { color: var(--gri-500); }
  .mini__btn { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--gri-300); border-radius: 999px; background: #fff; color: var(--murekkep); transition: background var(--hiz) var(--ease), color var(--hiz) var(--ease), border-color var(--hiz) var(--ease); }
  .mini__btn:hover { background: var(--kirmizi); border-color: var(--kirmizi); color: #fff; }
  .mini__btn.eklendi { background: var(--murekkep); border-color: var(--murekkep); color: #fff; }
</style>
