---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { kategoriler, markalar, site, whatsappUrl, type Kategori, type MarkaSlug, type Tur } from '../data/site';
import { urunler } from '../data/urunler';
import kediFoto from '../assets/foto/kedi.jpg';
import kopekFoto from '../assets/foto/kopek.jpg';

const yol = Astro.url.pathname;
const say = (f: (u: (typeof urunler)[number]) => boolean) => urunler.filter(f).length;
const menu: { tur: Tur; ad: string; foto: ImageMetadata; kimin: { ad: string; etiket: string }[] }[] = [
  { tur: 'kedi', ad: 'Kedi', foto: kediFoto, kimin: [{ ad: 'Yavru', etiket: 'yavru' }, { ad: 'Yetişkin', etiket: 'yetişkin' }, { ad: 'Kısırlaştırılmış', etiket: 'kısırlaştırılmış' }, { ad: 'Hassas sindirim', etiket: 'hassas sindirim' }] },
  { tur: 'kopek', ad: 'Köpek', foto: kopekFoto, kimin: [{ ad: 'Yavru', etiket: 'yavru' }, { ad: 'Yetişkin', etiket: 'yetişkin' }, { ad: 'Küçük ırk', etiket: 'küçük ırk' }, { ad: 'Orta ırk', etiket: 'orta ırk' }, { ad: 'Büyük ırk', etiket: 'büyük ırk' }] },
];
const nav = [
  { href: '/kedi/kedi-kumu', ad: 'Kedi Kumu' },
  { href: '/urunler?kategori=odul', ad: 'Ödül' },
  ...(urunler.some((u) => u.kampanya && u.stok) ? [{ href: '/urunler?kampanya=1', ad: 'Kampanya' }] : []),
  { href: '/urunler', ad: 'Tüm Ürünler' },
  { href: '/rehber', ad: 'Rehber' },
  { href: '/magaza', ad: 'Mağaza' },
  { href: '/siparislerim', ad: 'Siparişlerim' },
];
const aktif = (h: string) => (h === '/urunler' ? yol === h : yol === h || (h !== '/' && yol.startsWith(h + '/')));
import type { ImageMetadata } from 'astro';
---
<header class="ust">
  <div class="ust__ana">
    <div class="kap ust__ic">
      <button type="button" class="ust__menu" data-menu-ac aria-label="Menü"><Icon ad="list" boyut={26} /></button>
      <a href="/" class="ust__logo" aria-label="Pet Shop 6 ana sayfa"><Logo tip="amblem" yukseklik={52} oncelik /></a>
      <form class="ara" role="search" action="/urunler" method="get" data-ara>
        <label for="ara-giris" class="sr">Ürün ara</label>
        <input id="ara-giris" class="ara__giris" type="search" name="q" placeholder="Mama, kum, marka ara" autocomplete="off" />
        <button type="submit" class="ara__btn" aria-label="Ara"><Icon ad="magnifying-glass" agirlik="bold" boyut={20} /></button>
        <div class="ara__sonuc" data-ara-sonuc hidden></div>
      </form>
      <div class="ust__aksiyon">
        <a class="ust__wa" href={whatsappUrl()} target="_blank" rel="noopener"><Icon ad="whatsapp-logo" boyut={24} /><span>WhatsApp</span></a>
        <button type="button" class="ust__sepet" data-sepet-ac aria-label="Sepeti aç">
          <Icon ad="basket" boyut={24} />
          <span>Sepet</span>
          <b class="ust__rozet" data-sepet-sayi hidden>0</b>
        </button>
      </div>
    </div>
  </div>
  <div class="ust__alt">
    <div class="kap ust__alt-ic">
      <nav class="ust__nav" aria-label="Kategoriler">
        {menu.map((m) => (
          <div class="mega-kok">
            <a href={`/${m.tur}`} aria-current={aktif(`/${m.tur}`) ? 'page' : undefined} aria-haspopup="true">{m.ad} <Icon ad="caret-down" agirlik="bold" boyut={12} /></a>
            <div class="mega" role="group" aria-label={`${m.ad} menüsü`}>
              <div class="mega__kol">
                <strong>Kategoriler</strong>
                {(Object.keys(kategoriler) as Kategori[]).filter((k) => say((u) => u.tur === m.tur && u.kategori === k) > 0).map((k) => (
                  <a href={`/${m.tur}/${k}`}>{kategoriler[k].ad} <small>{say((u) => u.tur === m.tur && u.kategori === k)}</small></a>
                ))}
                <a href={`/${m.tur}`} class="mega__tum">Tüm {m.ad.toLocaleLowerCase('tr-TR')} ürünleri</a>
              </div>
              <div class="mega__kol">
                <strong>Kimin için</strong>
                {m.kimin.map((k) => <a href={`/${m.tur}?etiket=${encodeURIComponent(k.etiket)}`}>{k.ad} <small>{say((u) => u.tur === m.tur && u.etiketler.includes(k.etiket))}</small></a>)}
              </div>
              <div class="mega__kol">
                <strong>Markalar</strong>
                {(Object.keys(markalar) as MarkaSlug[]).filter((mk) => say((u) => u.tur === m.tur && u.markaSlug === mk) > 0).map((mk) => (
                  <a href={`/${m.tur}?marka=${mk}`}>{markalar[mk].ad} <small>{say((u) => u.tur === m.tur && u.markaSlug === mk)}</small></a>
                ))}
              </div>
              <a class="mega__foto" href={`/${m.tur}`}>
                <Image src={m.foto} alt="" width={360} height={360} loading="lazy" />
              </a>
            </div>
          </div>
        ))}
        {nav.map((n) => <a href={n.href} aria-current={aktif(n.href) ? 'page' : undefined} class:list={{ 'ust__nav-kampanya': n.href.includes('kampanya') }}>{n.ad}</a>)}
      </nav>
      <p class="ust__soz"><Icon ad="truck" boyut={18} /> <b>{site.teslimat.bolge} ücretsiz teslimat</b> <span aria-hidden="true">·</span> Alo Mama <a href={`tel:${site.aloMamaTel}`}>{site.aloMama}</a></p>
    </div>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menü">
  <div class="menu__ic">
    <div class="menu__bas">
      <Logo tip="tam" genislik={132} />
      <button type="button" class="menu__kapat" data-menu-kapat aria-label="Kapat"><Icon ad="x" boyut={22} /></button>
    </div>
    <form class="ara ara--menu" role="search" action="/urunler" method="get">
      <label for="ara-giris-m" class="sr">Ürün ara</label>
      <input id="ara-giris-m" class="ara__giris" type="search" name="q" placeholder="Mama, kum, marka ara" />
      <button type="submit" class="ara__btn" aria-label="Ara"><Icon ad="magnifying-glass" agirlik="bold" boyut={20} /></button>
    </form>
    <nav class="menu__nav" aria-label="Sayfalar">
      <a href="/kedi">Kedi <small>mama, ödül, kum</small></a>
      <a href="/kopek">Köpek <small>mama, ödül</small></a>
      <a href="/kedi/kedi-kumu">Kedi Kumu</a>
      <a href="/urunler">Tüm Ürünler</a>
      <a href="/rehber">Rehber <small>bakım yazıları</small></a>
      <a href="/magaza">Mağaza</a>
      <a href="/siparislerim">Siparişlerim</a>
      <a href="/teslimat">Sipariş ve Teslimat</a>
      <a href="/sss">Sık Sorulanlar</a>
    </nav>
    <div class="menu__alt">
      <a class="btn btn--wa btn--genis" href={whatsappUrl()} target="_blank" rel="noopener"><Icon ad="whatsapp-logo" /> WhatsApp'tan yaz</a>
      <a class="btn btn--ikinci btn--genis" href={`tel:${site.aloMamaTel}`}><Icon ad="phone" /> Alo Mama {site.aloMama}</a>
    </div>
  </div>
</dialog>

<style>
  /* Red bar (sticky) + white category row, like a real retailer header */
  .ust__ana { position: sticky; top: 0; z-index: 40; background: rgb(14 13 11 / 0.94); backdrop-filter: blur(12px); color: var(--metin); border-bottom: 1px solid var(--cizgi); }
  .ust__ic { display: flex; align-items: center; gap: 10px; min-height: var(--ust); flex-wrap: wrap; padding-block: 8px; }
  .ust__logo { display: flex; align-items: center; text-decoration: none; margin-right: 4px; }
  .ust__logo :global(.logo) { height: 44px; }
  .ust__menu { display: inline-grid; place-items: center; width: 42px; height: 42px; border: 0; background: transparent; color: #fff; border-radius: var(--radius); }
  .ust__menu:hover { color: var(--altin); }
  .ara { position: relative; display: flex; flex: 1 1 100%; order: 10; min-width: 0; }
  .ara__giris { width: 100%; height: 44px; padding: 0 52px 0 16px; border: 1px solid var(--cizgi); border-radius: var(--radius); background: var(--yuzey); color: var(--metin); font-size: 0.95rem; }
  .ara__giris:focus { outline: none; border-color: var(--altin); box-shadow: 0 0 0 3px rgb(201 162 77 / 0.16); }
  .ara__giris::placeholder { color: var(--metin-3); }
  .ara__giris::-webkit-search-cancel-button { appearance: none; }
  .ara__btn { position: absolute; right: 5px; top: 5px; width: 34px; height: 34px; border: 0; border-radius: var(--radius); background: var(--altin); color: #17150f; display: grid; place-items: center; }
  .ara__btn:hover { background: var(--altin-acik); }
  .ara__sonuc { position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: var(--yuzey); color: var(--metin); border: 1px solid var(--cizgi); border-radius: var(--radius-lg); box-shadow: var(--golge); overflow: hidden; z-index: 50; }
  .ust__aksiyon { display: flex; align-items: center; gap: 2px; margin-left: auto; }
  .ust__wa, .ust__sepet { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 10px; border: 0; border-radius: var(--radius); background: transparent; color: var(--metin); font-family: var(--font-baslik); font-weight: 400; letter-spacing: 0.04em; text-decoration: none; font-size: 0.92rem; position: relative; transition: color var(--hiz) var(--ease); }
  .ust__wa span, .ust__sepet span { display: none; }
  .ust__wa:hover, .ust__sepet:hover { color: var(--altin); }
  .ust__rozet { position: absolute; top: 2px; right: 2px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: var(--altin); color: #17150f; font-size: 0.72rem; font-weight: 700; display: grid; place-items: center; line-height: 1; }
  .ust__alt { display: none; background: var(--zemin); border-bottom: 1px solid var(--cizgi); }
  .ust__alt-ic { display: flex; align-items: center; gap: 16px; min-height: 46px; }
  .ust__nav { display: flex; gap: 2px; }
  .ust__nav a { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border-radius: var(--radius); text-decoration: none; font-family: var(--font-baslik); font-weight: 400; text-transform: uppercase; letter-spacing: 0.13em; font-size: 0.74rem; color: var(--metin-2); white-space: nowrap; transition: color var(--hiz) var(--ease); }
  .ust__nav a:hover { color: var(--altin); }
  .ust__nav a[aria-current] { color: var(--altin); }
  .ust__nav-kampanya { color: var(--altin-acik) !important; }
  .ust__nav > .mega-kok > a .ikon { color: var(--metin-3); transition: transform var(--hiz) var(--ease); }
  .ust__soz { margin-left: auto; display: flex; align-items: center; gap: 7px; font-size: 0.8rem; color: var(--metin-3); white-space: nowrap; }
  .ust__soz b { color: var(--metin-2); font-weight: 500; }
  .ust__soz a { font-weight: 500; text-decoration: none; color: var(--altin); }
  .ust__soz a:hover { color: var(--altin-acik); }
  .mega-kok { position: relative; }
  .mega-kok:hover > a .ikon, .mega-kok:focus-within > a .ikon { transform: rotate(180deg); }
  .mega { position: absolute; left: -12px; top: calc(100% + 8px); z-index: 45; display: grid; grid-template-columns: 1fr 1fr 1fr 200px; gap: 24px; width: 720px; padding: 26px; background: var(--yuzey); border: 1px solid var(--cizgi); border-radius: var(--radius-lg); box-shadow: var(--golge); opacity: 0; translate: 0 6px; visibility: hidden; transition: opacity 160ms var(--ease), translate 200ms var(--ease), visibility 0s linear 160ms; }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
  .mega-kok:hover .mega, .mega-kok:focus-within .mega { opacity: 1; translate: 0 0; visibility: visible; transition-delay: 60ms, 60ms, 0s; }
  .mega__kol { display: grid; align-content: start; gap: 2px; }
  .mega__kol strong { font-family: var(--font-baslik); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--metin-3); font-weight: 400; margin-bottom: 10px; }
  .mega__kol a { display: flex; justify-content: space-between; gap: 10px; padding: 7px 8px; margin: 0 -8px; border-radius: var(--radius); font-weight: 400; font-size: 0.95rem; color: var(--metin); text-decoration: none; transition: color var(--hiz) var(--ease); }
  .mega__kol a:hover { color: var(--altin); }
  .mega__kol a small { color: var(--metin-3); font-variant-numeric: tabular-nums; }
  .mega__tum { margin-top: 10px !important; padding-top: 12px !important; border-top: 1px solid var(--cizgi); color: var(--altin) !important; }
  .mega__foto { display: block; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; background: var(--yuzey-2); padding: 0 !important; }
  .mega__foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease); }
  .mega__foto:hover img { transform: scale(1.04); }
  @media (min-width: 720px) {
    .ust__ic { flex-wrap: nowrap; padding-block: 0; }
    .ara { flex: 1 1 auto; order: 0; max-width: 560px; margin-inline: 12px auto; }
    .ust__wa span, .ust__sepet span { display: inline; }
    .ust__rozet { position: static; margin-left: -2px; }
    .ust__aksiyon { margin-left: 0; }
  }
  @media (min-width: 1040px) { .ust__alt { display: block; } .ust__menu { display: none; } .ust__logo :global(.logo) { height: 52px; } }
  @media (max-width: 1239px) { .ust__soz { display: none; } }

  /* Mobile menu */
  .menu { border: 0; padding: 0; margin: 0; max-width: none; max-height: none; width: min(100%, 360px); height: 100dvh; background: var(--zemin); color: var(--metin); border-right: 1px solid var(--cizgi); box-shadow: var(--golge); }
  .menu::backdrop { background: rgb(0 0 0 / 0.66); }
  .menu[open] { animation: menu-gir 260ms var(--ease); }
  .menu.kapaniyor { animation: menu-cik 200ms var(--ease) forwards; }
  @keyframes menu-gir { from { translate: -100% 0; } to { translate: 0 0; } }
  @keyframes menu-cik { to { translate: -100% 0; } }
  .menu__ic { display: flex; flex-direction: column; height: 100%; padding: 16px; gap: 18px; }
  .menu__bas { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: -16px -16px 0; padding: 14px 16px; border-bottom: 1px solid var(--cizgi); }
  .menu__bas :global(.logo) { width: 132px; }
  .menu__kapat { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--cizgi); background: transparent; color: var(--metin); border-radius: var(--radius); }
  .ara--menu { display: flex; max-width: none; margin: 0; }
  .ara--menu .ara__giris { background: var(--yuzey); }
  .menu__nav { display: grid; }
  .menu__nav a { display: flex; align-items: baseline; justify-content: space-between; padding: 15px 4px; border-bottom: 1px solid var(--cizgi); text-decoration: none; font-family: var(--font-baslik); font-weight: 400; font-size: 1.15rem; }
  .menu__nav small { font-weight: 400; color: var(--metin-3); font-size: 0.82rem; }
  .menu__alt { margin-top: auto; display: grid; gap: 8px; }
</style>

<script>
  import { baslat as aramaBaslat } from '../scripts/ara';
  const dlg = document.getElementById('menu') as HTMLDialogElement | null;
  if (dlg && !dlg.dataset.init) {
    dlg.dataset.init = '1';
    const kapat = () => { dlg.classList.add('kapaniyor'); setTimeout(() => { dlg.close(); dlg.classList.remove('kapaniyor'); }, 190); };
    document.querySelectorAll('[data-menu-ac]').forEach((b) => b.addEventListener('click', () => dlg.showModal()));
    dlg.querySelectorAll('[data-menu-kapat]').forEach((b) => b.addEventListener('click', kapat));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) kapat(); });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); kapat(); });
  }
  aramaBaslat();
</script>
