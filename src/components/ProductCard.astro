---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { fiyat } from '../data/site';
import type { Urun } from '../data/urunler';

interface Props { urun: Urun; oncelik?: boolean; kucukKart?: boolean }
const { urun: u, oncelik = false, kucukKart = false } = Astro.props;
const tek = u.secenekler.length === 1;
const ilk = u.secenekler[0];
const etiketStr = u.etiketler.join('|');
const kucuk = await getImage({ src: u.gorsel, width: 160, height: 160, fit: 'contain', format: 'webp' });
const uid = `boy-${u.slug}-${Math.random().toString(36).slice(2, 6)}`;
---
<article class:list={['kart', { 'kart--kucuk': kucukKart }]} data-urun data-tur={u.tur} data-kategori={u.kategori} data-marka={u.markaSlug} data-etiket={etiketStr} data-ad={u.ad} data-fiyat={u.baslangic}>
  <a class="kart__gorsel" href={`/urun/${u.slug}`} tabindex="-1" aria-hidden="true">
    <Image src={u.gorsel} alt="" width={480} height={480} fit="contain" loading={oncelik ? 'eager' : 'lazy'} decoding="async" widths={[240, 480]} sizes="(min-width: 1040px) 280px, (min-width: 720px) 30vw, 45vw" />
  </a>
  <div class="kart__govde">
    <span class="kart__marka">{u.marka}</span>
    <h3 class="kart__ad"><a href={`/urun/${u.slug}`}>{u.ad}</a></h3>
    <form class="kart__form" data-sepete-ekle method="post" action="/sepet">
      <input type="hidden" name="slug" value={u.slug} />
      <input type="hidden" name="ad" value={u.ad} />
      <input type="hidden" name="marka" value={u.marka} />
      <input type="hidden" name="gorsel" value={kucuk.src} />
      {tek ? (
        <>
          <input type="hidden" name="boy" value={`${ilk.boy}|${ilk.fiyat}`} />
          <span class="kart__tekboy">{ilk.boy}</span>
        </>
      ) : (
        <div class="cipler kart__cipler" role="radiogroup" aria-label="Boy">
          {u.secenekler.map((s, i) => (
            <label class="cip"><input type="radio" name="boy" value={`${s.boy}|${s.fiyat}`} checked={i === 0} data-fiyat={fiyat(s.fiyat)} data-boy-sec />{s.boy}</label>
          ))}
        </div>
      )}
      <div class="kart__satir">
        <strong class="kart__fiyat" data-fiyat-goster>{fiyat(ilk.fiyat)}</strong>
        <button type="submit" class="kart__btn" aria-label={`Sepete ekle: ${u.ad}`}><Icon ad="plus" agirlik="bold" boyut={18} /><span>Sepete ekle</span></button>
      </div>
    </form>
  </div>
</article>
<style>
  .kart { position: relative; display: flex; flex-direction: column; gap: 10px; min-width: 0; container-type: inline-size; }
  .kart__gorsel { display: block; position: relative; aspect-ratio: 1; background: var(--gri-100); border-radius: var(--radius-lg); overflow: hidden; transition: background var(--hiz) var(--ease); }
  .kart__gorsel img { position: absolute; inset: 11%; width: 78%; height: 78%; object-fit: contain; transition: transform 380ms var(--ease); }
  .kart:hover .kart__gorsel { background: var(--gri-200); }
  .kart:hover .kart__gorsel img { transform: scale(1.05); }
  .kart__govde { display: flex; flex-direction: column; gap: 6px; padding: 0 2px; flex: 1; }
  .kart__marka { font-size: 0.78rem; font-weight: 600; color: var(--gri-500); }
  .kart__ad { font-family: var(--font-govde); font-size: 0.95rem; font-weight: 600; font-stretch: 100%; letter-spacing: 0; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .kart__ad a { text-decoration: none; }
  .kart__ad a::after { content: ''; position: absolute; inset: 0; }
  .kart__form { position: relative; z-index: 1; display: grid; gap: 10px; margin-top: auto; padding-top: 4px; }
  .kart__cipler { min-height: 32px; }
  .kart__tekboy { display: inline-flex; align-items: center; min-height: 32px; font-size: 0.84rem; color: var(--gri-700); }
  .kart__satir { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .kart__fiyat { font-family: var(--font-baslik); font-weight: 800; font-size: 1.2rem; white-space: nowrap; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .kart__btn { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 14px 0 10px; border: 0; border-radius: 999px; background: var(--kirmizi); color: #fff; font-weight: 700; font-size: 0.88rem; white-space: nowrap; transition: background var(--hiz) var(--ease), transform var(--hiz) var(--ease); }
  .kart__btn:hover { background: var(--kirmizi-koyu); }
  .kart__btn:active { transform: scale(0.97); }
  .kart__btn.eklendi { background: var(--murekkep); }
  .kart--kucuk .kart__btn span { display: none; }
  .kart--kucuk .kart__btn { padding: 0 10px; }
  @container (max-width: 215px) { .kart__btn span { display: none; } .kart__btn { padding: 0 11px; } }
  @media (hover: none) { .kart:hover .kart__gorsel img { transform: none; } }
</style>
