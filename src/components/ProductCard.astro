---
import { Image, getImage } from 'astro:assets';
import { fiyat, kategoriler } from '../data/site';
import type { Urun } from '../data/urunler';

interface Props { urun: Urun; oncelik?: boolean }
const { urun: u, oncelik = false } = Astro.props;
const tek = u.secenekler.length === 1;
const ilk = u.secenekler[0];
const etiketStr = u.etiketler.join('|');
const kucuk = await getImage({ src: u.gorsel, width: 160, height: 160, fit: 'contain', format: 'webp' });
---
<article class="kart" data-urun data-tur={u.tur} data-kategori={u.kategori} data-marka={u.markaSlug} data-etiket={etiketStr} data-ad={u.ad} data-fiyat={u.baslangic}>
  <a class="kart__gorsel" href={`/urun/${u.slug}`} tabindex="-1" aria-hidden="true">
    <Image src={u.gorsel} alt="" width={480} height={480} fit="contain" loading={oncelik ? 'eager' : 'lazy'} decoding="async" widths={[240, 480]} sizes="(min-width: 1040px) 280px, (min-width: 720px) 30vw, 45vw" />
  </a>
  <div class="kart__govde">
    <span class="kart__marka">{u.marka} <span class="kart__kat">· {kategoriler[u.kategori].ad}</span></span>
    <h3 class="kart__ad"><a href={`/urun/${u.slug}`}>{u.ad}</a></h3>
    <form class="kart__form" data-sepete-ekle method="post" action="/sepet">
      <input type="hidden" name="slug" value={u.slug} />
      <input type="hidden" name="ad" value={u.ad} />
      <input type="hidden" name="marka" value={u.marka} />
      <input type="hidden" name="gorsel" value={kucuk.src} />
      <div class="kart__satir">
        {tek ? (
          <>
            <input type="hidden" name="boy" value={`${ilk.boy}|${ilk.fiyat}`} />
            <span class="kart__boy">{ilk.boy}</span>
          </>
        ) : (
          <label class="kart__sec">
            <span class="sr">Boy</span>
            <select name="boy" class="kart__select" data-boy-sec>
              {u.secenekler.map((s) => <option value={`${s.boy}|${s.fiyat}`} data-fiyat={fiyat(s.fiyat)}>{s.boy}</option>)}
            </select>
          </label>
        )}
        <strong class="kart__fiyat" data-fiyat-goster>{fiyat(ilk.fiyat)}</strong>
      </div>
      <button type="submit" class="btn btn--kucuk btn--genis kart__btn">Sepete ekle</button>
    </form>
  </div>
</article>
<style>
  .kart { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--gri-200); border-radius: var(--radius-lg); overflow: hidden; transition: border-color var(--hiz) var(--ease), box-shadow var(--hiz) var(--ease); }
  .kart:hover { border-color: var(--gri-400); box-shadow: var(--golge); }
  .kart__gorsel { display: block; position: relative; aspect-ratio: 1; background: #fff; }
  .kart__gorsel img { position: absolute; inset: 10%; width: 80%; height: 80%; object-fit: contain; transition: transform 300ms var(--ease); }
  .kart:hover .kart__gorsel img { transform: scale(1.04); }
  .kart__govde { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px 14px; border-top: 1px solid var(--gri-100); flex: 1; }
  .kart__marka { font-size: 0.78rem; color: var(--gri-500); font-weight: 600; }
  .kart__kat { font-weight: 500; }
  .kart__ad { font-family: var(--font-govde); font-size: 0.95rem; font-weight: 600; font-stretch: 100%; letter-spacing: 0; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
  .kart__ad a { text-decoration: none; }
  .kart__ad a::after { content: ''; position: absolute; inset: 0; }
  .kart { position: relative; }
  .kart__form { position: relative; z-index: 1; display: grid; gap: 8px; margin-top: auto; }
  .kart__satir { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .kart__boy { font-size: 0.88rem; color: var(--gri-700); padding: 0 2px; }
  .kart__select { height: 34px; padding: 0 28px 0 8px; border: 1px solid var(--gri-300); border-radius: var(--radius); background: #fff url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' fill='%23181818'><path d='M213.66 101.66l-80 80a8 8 0 0 1-11.32 0l-80-80a8 8 0 0 1 11.32-11.32L128 164.69l74.34-74.35a8 8 0 0 1 11.32 11.32Z'/></svg>") no-repeat right 8px center / 12px; appearance: none; font-size: 0.88rem; max-width: 130px; }
  .kart__fiyat { font-family: var(--font-baslik); font-weight: 700; font-size: 1.1rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .kart__btn.eklendi { background: var(--murekkep); border-color: var(--murekkep); }
  @media (hover: none) { .kart:hover .kart__gorsel img { transform: none; } }
</style>
